{
  "manifest_version": 3,
  "name": "Desktop Cat",
  "version": "1.0",
  "description": "A cute cat that lives on your screen!",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/cat sitting.png",
      "48": "assets/cat sitting.png",
      "128": "assets/cat sitting.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}