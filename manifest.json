{
  "manifest_version": 3,
  "name": "Desktop Cat",
  "version": "1.0",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/cat picked up.png",
        "assets/cat happy seq.png",
        "assets/cat walking seq.png",
        "assets/cat sitting.png",
        "assets/cat sleeping seq.png",
        "assets/cat lying.png"
     ],
      "matches": ["<all_urls>"]
    }
  ]
}