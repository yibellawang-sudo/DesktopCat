{
  "manifest_version": 3,
  "name": "Desktop Cat",
  "version": "1.3",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "assets/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/ragdoll/*",
        "assets/calico/*",
        "assets/orange/*",
        "assets/black/*",
        "assets/tabby/*",
        "assets/lucky-coin-font/*",
        "assets/crows-ink-font/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}